          "name": "Kushki Void Or Refund Charge",
          "request": {
            "name": "Kushki Void Or Refund Charge",
            "description": {
              "content": "Void (same day, before settlement) or refund (after settlement) a previously approved charge.\nPass a partial amount in the body to perform a partial refund; omit amount to void the full transaction.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "charges",
                ":ticketNumber"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ticketNumber",
                  "description": "(Required) Ticket number returned by the original charge."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {\n    \"subtotalIva\": \"<number>\",\n    \"subtotalIva0\": \"<number>\",\n    \"iva\": \"<number>\",\n    \"currency\": \"<string>\",\n    \"ice\": 0,\n    \"extraTaxes\": {\n      \"key_0\": \"<number>\",\n      \"key_1\": \"<number>\",\n      \"key_2\": \"<number>\"\n    }\n  },\n  \"fullResponse\": false\n}",
